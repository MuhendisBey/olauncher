<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://muhendisbey.github.io/olauncher"
        version="1.13.0"
        viewmodes="maximized">
  <!-- Package must be exactly 10 alphanumeric characters -->
  <!-- KEEP THIS APPLICATION ID STABLE: the TV's Home-button mapping targets it directly -->
  <tizen:application id="OLauncher1.OLauncher" package="OLauncher1" required_version="6.5"/>
  <content src="index.html"/>
  <icon src="icon.png"/>
  <name>OLauncher</name>

  <feature name="http://tizen.org/feature/screen.size.all"/>

  <!-- Tizen Privileges (Minimal set: launch, app catalog, HDMI source, foreground HA) -->
  <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
  <tizen:privilege name="http://tizen.org/privilege/application.info"/>
  <tizen:privilege name="http://tizen.org/privilege/tv.window"/>
  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <access origin="*" subdomains="true"/>

  <!-- Declare home return support and multitasking for instant 0ms app-switch resume -->
  <tizen:metadata key="http://samsung.com/tv/metadata/homereturnsupport" value="true"/>
  <tizen:metadata key="http://samsung.com/tv/metadata/multitasking.support" value="true"/>

  <tizen:profile name="tv-samsung"/>
  <tizen:setting screen-orientation="landscape"
                 context-menu="disable"
                 background-support="disable"
                 encryption="disable"
                 install-location="auto"
                 hwkey-event="enable"
                 pointing-device-support="disable"/>
</widget>
